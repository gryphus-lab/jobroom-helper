# Copy this file to .env and fill in your own values.
# .env is git-ignored and is specific to your user/instance.

# Target website base URL
WEBSITE_URL=https://www.job-room.ch/

# Optional: path to the local SQLite tracker database
# JOBROOM_DB_PATH=data/applications.db

# Optional: enable the headless-browser scraping fallback (1/true/yes/on)
ENABLE_BROWSER_FALLBACK=
